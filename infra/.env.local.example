# Optional settings for infra/compose.local.yml: copy to infra/.env.local, fill in what you need, and start with
#   docker compose -f infra/compose.local.yml --env-file infra/.env.local up -d --build --wait
# Everything here can also be left out: choose your model and key on the first-run screen instead.
WEB_PORT=8080
POSTGRES_PASSWORD=agentcanvas-local
# server-wide model keys (any you have)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
# where local model servers run, seen from the API container (default: your computer)
AGENTCANVAS_LOCAL_MODELS_HOST=host.docker.internal
