# Copy to infra/.env.prod and fill in. Never commit the filled-in file.
POSTGRES_PASSWORD=
# the API's own database role (agentcanvas_app, created by the migrate service): not the owner, so row-level security applies
POSTGRES_APP_PASSWORD=
AGENTCANVAS_SECRET_KEY=
# encrypts conversation checkpoints at rest: exactly 32 random characters (openssl rand -hex 16)
LANGGRAPH_AES_KEY=
# optional master key for secrets (envelope encryption): file:/run/secrets/master.key, aws:<key ARN>, gcp:<key name>
AGENTCANVAS_KMS_KEY=
# sign-in (required in prod): a public SPA client with redirect URI https://<app>/auth/callback
AGENTCANVAS_OIDC_ISSUER=https://login.example.com/realms/acme
AGENTCANVAS_OIDC_AUDIENCE=agentcanvas-api
AGENTCANVAS_OIDC_CLIENT_ID=agentcanvas-web
AGENTCANVAS_BOOTSTRAP_ADMIN_EMAILS=["you@example.com"]
AGENTCANVAS_CORS_ORIGINS=["https://agentcanvas.example.com"]
# model providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# images and scale
API_IMAGE=agentcanvas-api:latest
WEB_IMAGE=agentcanvas-web:latest
API_REPLICAS=2
WEB_PORT=8080
