# syntax=docker/dockerfile:1.7
# API image (M8-T1). Build context: apps/api
#   docker build -f infra/Dockerfile.api -t agentcanvas-api apps/api
# Runs as uid 10001. Migrations: `alembic upgrade head` (the compose `migrate` service, the Helm hook Job).
# Base images are pinned by digest (Dependabot proposes updates weekly). To pull one from a mirror, replace the
# exact reference: --build-context 'python:3.12-slim@sha256:<digest>=docker-image://mirror.gcr.io/library/python@sha256:<digest>'
FROM ghcr.io/astral-sh/uv:0.12@sha256:61d393e44e249f2e4b526b6c7ddcecce245946826e608e11c93ad4f5bba55b21 AS uv

FROM python:3.12-slim@sha256:02108f5d322dd89f1c9e552442c25acb0543dfdbc455693a5599624f20d9155d AS python

FROM python AS build
COPY --from=uv /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
# 1) dependencies only (cached until the lockfile changes)
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev --no-install-project
# 2) the application
COPY . .
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev
# 3) optional (S27): CrewAI in an environment of its own, so workflows designed for CrewAI run here (about 800 MB):
#   docker build --build-arg WITH_CREWAI=true ...   Without it they can still be designed and exported.
ARG WITH_CREWAI=false
RUN --mount=type=cache,target=/root/.cache/uv if [ "$WITH_CREWAI" = "true" ]; then \
      uv venv .frameworks/crewai && uv pip install --python .frameworks/crewai/bin/python crewai==1.15.25; fi

FROM python AS runtime
# git: project workspaces are git repositories (M5-T1); upgrade: OS security fixes newer than the base image (M8-T6)
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 app \
    && mkdir -p /data/workspaces && chown app:app /data/workspaces
COPY --from=build --chown=app:app /app /app
WORKDIR /app
ENV PATH=/app/.venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    AGENTCANVAS_WORKSPACES_DIR=/data/workspaces \
    AGENTCANVAS_LOG_JSON=true \
    # proxies whose X-Forwarded-* headers are trusted (uvicorn); set to the ingress / load balancer addresses
    FORWARDED_ALLOW_IPS=127.0.0.1
USER 10001
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=2)" || exit 1
# --timeout-graceful-shutdown: SIGTERM lets open streams finish for up to 30 s (the orchestrator waits longer)
CMD ["uvicorn", "agentcanvas.api.main:app", "--host", "0.0.0.0", "--port", "8000", \
     "--proxy-headers", "--timeout-graceful-shutdown", "30"]
