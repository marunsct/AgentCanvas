# syntax=docker/dockerfile:1.7
# API image (M8-T1). Build context: apps/api
#   docker build -f infra/Dockerfile.api -t agentcanvas-api apps/api
# Runs as uid 10001. Migrations: `alembic upgrade head` (the compose `migrate` service, the Helm hook Job).
# Base images are pinned by digest (Dependabot proposes updates weekly). To pull one from a mirror, replace the
# exact reference: --build-context 'python:3.12-slim@sha256:<digest>=docker-image://mirror.gcr.io/library/python@sha256:<digest>'
# Mastra (step 8) is built from the Node.js image only when asked for
ARG WITH_MASTRA=false
FROM ghcr.io/astral-sh/uv:0.13@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 AS uv

FROM python:3.14-slim@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170 AS python

FROM python AS build
COPY --from=uv /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
# 1) dependencies only (cached until the lockfile changes)
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev --no-install-project
# 2) the application
COPY . .
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev
# 3)-7) optional frameworks, each in a Python environment of its own so its workflows run here: name them in
#   FRAMEWORKS (space- or comma-separated ids, or "all"), e.g. --build-arg FRAMEWORKS="crewai google_adk" (the Docker
#   app: `make docker-up`, all by default), or with the older WITH_<ID>=true arguments. Without them those workflows can
#   still be designed and exported. The Docker app (infra/compose.local.yml) passes FRAMEWORKS=all by default.
#   Each environment is installed from its lock in framework-locks/ (every package pinned, with hashes), so two builds
#   ship the same packages; `scripts/framework_versions.py lock` regenerates the locks from the pins.
ARG FRAMEWORKS=""
# 3) optional (S27): CrewAI in an environment of its own, so workflows designed for CrewAI run here (about 800 MB):
#   docker build --build-arg WITH_CREWAI=true ...   Without it they can still be designed and exported.
ARG WITH_CREWAI=false
RUN --mount=type=cache,target=/root/.cache/uv if [ "$WITH_CREWAI" = "true" ] || echo " $FRAMEWORKS " | tr , " " | grep -Eq " (all|crewai) "; then \
      UV_PYTHON_DOWNLOADS=automatic UV_PYTHON_INSTALL_DIR=/app/.python uv venv --python 3.13 .frameworks/crewai \
      && uv pip sync --require-hashes --python .frameworks/crewai/bin/python framework-locks/crewai.txt; fi
#   ^ CrewAI supports Python <3.14 (PyPI requires_python), so its environment gets a Python 3.13 of its own, kept
#     under /app (the runtime stage copies /app), as `make crewai` and CI test it
# 4) optional (S29): Google ADK in an environment of its own, for workflows designed for ADK and ADK agents in mixed
#   flows (about 350 MB): docker build --build-arg WITH_GOOGLE_ADK=true ...
ARG WITH_GOOGLE_ADK=false
RUN --mount=type=cache,target=/root/.cache/uv if [ "$WITH_GOOGLE_ADK" = "true" ] || echo " $FRAMEWORKS " | tr , " " | grep -Eq " (all|google_adk) "; then \
      uv venv .frameworks/google_adk \
      && uv pip sync --require-hashes --python .frameworks/google_adk/bin/python framework-locks/google_adk.txt; fi
# 5) optional (S32): Pydantic AI and Agno, each in an environment of its own, for workflows designed for them and their
#   agents in mixed flows: docker build --build-arg WITH_PYDANTIC_AI=true --build-arg WITH_AGNO=true ...
ARG WITH_PYDANTIC_AI=false
RUN --mount=type=cache,target=/root/.cache/uv if [ "$WITH_PYDANTIC_AI" = "true" ] || echo " $FRAMEWORKS " | tr , " " | grep -Eq " (all|pydantic_ai) "; then \
      uv venv .frameworks/pydantic_ai \
      && uv pip sync --require-hashes --python .frameworks/pydantic_ai/bin/python framework-locks/pydantic_ai.txt; fi
ARG WITH_AGNO=false
RUN --mount=type=cache,target=/root/.cache/uv if [ "$WITH_AGNO" = "true" ] || echo " $FRAMEWORKS " | tr , " " | grep -Eq " (all|agno) "; then \
      uv venv .frameworks/agno && uv pip sync --require-hashes --python .frameworks/agno/bin/python framework-locks/agno.txt; fi
# 6) optional (S33–S34): the Microsoft Agent Framework in an environment of its own, for workflows designed for it:
#   docker build --build-arg WITH_MICROSOFT_AGENT_FRAMEWORK=true ...
ARG WITH_MICROSOFT_AGENT_FRAMEWORK=false
RUN --mount=type=cache,target=/root/.cache/uv if [ "$WITH_MICROSOFT_AGENT_FRAMEWORK" = "true" ] || echo " $FRAMEWORKS " | tr , " " | grep -Eq " (all|microsoft_agent_framework) "; then \
      uv venv .frameworks/microsoft_agent_framework && uv pip sync \
      --require-hashes --python .frameworks/microsoft_agent_framework/bin/python framework-locks/microsoft_agent_framework.txt; fi
# 7) optional (S35): Strands Agents and LlamaIndex, each in an environment of its own:
#   docker build --build-arg WITH_STRANDS=true --build-arg WITH_LLAMAINDEX=true ...
ARG WITH_STRANDS=false
RUN --mount=type=cache,target=/root/.cache/uv if [ "$WITH_STRANDS" = "true" ] || echo " $FRAMEWORKS " | tr , " " | grep -Eq " (all|strands) "; then \
      uv venv .frameworks/strands \
      && uv pip sync --require-hashes --python .frameworks/strands/bin/python framework-locks/strands.txt; fi
ARG WITH_LLAMAINDEX=false
RUN --mount=type=cache,target=/root/.cache/uv if [ "$WITH_LLAMAINDEX" = "true" ] || echo " $FRAMEWORKS " | tr , " " | grep -Eq " (all|llamaindex) "; then \
      uv venv .frameworks/llamaindex \
      && uv pip sync --require-hashes --python .frameworks/llamaindex/bin/python framework-locks/llamaindex.txt; fi

# 8) optional (S36): Mastra workflows run on Node.js 22.18+ with Mastra from npm, in /opt/mastra (node in bin/):
#   --build-arg WITH_MASTRA=true (the Docker app sets it unless FRAMEWORKS leaves Mastra out). Otherwise the folder stays empty.
FROM node:22.18.0-bookworm-slim@sha256:752ea8a2f758c34002a0461bd9f1cee4f9a3c36d48494586f60ffce1fc708e0e AS mastra-true
WORKDIR /opt/mastra
COPY agentcanvas/adapters/mastra/package.json agentcanvas/adapters/mastra/package-lock.json ./
RUN npm ci --no-audit --no-fund --loglevel=error && mkdir bin && cp /usr/local/bin/node bin/node
FROM python AS mastra-false
RUN mkdir -p /opt/mastra
FROM mastra-${WITH_MASTRA} AS mastra

FROM python AS runtime
# git: project workspaces are git repositories (M5-T1); upgrade: OS security fixes newer than the base image (M8-T6);
# tesseract: OCR for scanned PDFs and pictures in knowledge bases. English is included; add languages at build time
# with --build-arg OCR_LANGS="deu fra" and name them in AGENTCANVAS_OCR_LANGUAGES (eng+deu)
ARG OCR_LANGS=""
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends git tesseract-ocr tesseract-ocr-eng \
    $(for l in $OCR_LANGS; do printf 'tesseract-ocr-%s ' "$l"; done) \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 app \
    && mkdir -p /data/workspaces && chown app:app /data/workspaces \
    && python -m pip uninstall -y pip
# ^ the base image's pip (and the old urllib3, certifi and msgpack it vendors) is not used at run time: the app runs
#   from /app/.venv, which uv built; leaving pip out also leaves out what scanners flag in its vendored copies
COPY --from=build --chown=app:app /app /app
COPY --from=mastra --chown=app:app /opt/mastra /opt/mastra
WORKDIR /app
ENV PATH=/app/.venv/bin:/opt/mastra/bin:$PATH \
    AGENTCANVAS_IN_DOCKER=1 \
    AGENTCANVAS_MASTRA_DIR=/opt/mastra \
    PYTHONUNBUFFERED=1 \
    AGENTCANVAS_WORKSPACES_DIR=/data/workspaces \
    AGENTCANVAS_LOG_JSON=true \
    # proxies whose X-Forwarded-* headers are trusted (uvicorn); set to the ingress / load balancer addresses
    FORWARDED_ALLOW_IPS=127.0.0.1
USER 10001
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=2)" || exit 1
# --timeout-graceful-shutdown: SIGTERM lets open streams finish for up to 30 s (the orchestrator waits longer)
CMD ["uvicorn", "agentcanvas.api.main:app", "--host", "0.0.0.0", "--port", "8000", \
     "--proxy-headers", "--timeout-graceful-shutdown", "30"]
