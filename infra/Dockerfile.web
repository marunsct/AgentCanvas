# syntax=docker/dockerfile:1.7
# Web image (M8-T1). Build context: the repository root
#   docker build -f infra/Dockerfile.web -t agentcanvas-web .
# nginx (unprivileged, port 8080) serves the SPA and proxies /api/ to $API_UPSTREAM (default http://api:8000).
# Base images are pinned by digest (Dependabot proposes updates weekly). To pull one from a mirror, replace the
# exact reference: --build-context 'node:22-slim@sha256:<digest>=docker-image://mirror.gcr.io/library/node@sha256:<digest>'
FROM node:22-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS build
ARG PNPM_VERSION=10
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /repo/apps/web
COPY apps/web/package.json apps/web/pnpm-lock.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile
# the type check also covers test fixtures that read the IR schema package and an example workflow
COPY packages/ir-schema/ /repo/packages/ir-schema/
COPY apps/api/examples/ /repo/apps/api/examples/
COPY apps/web/ ./
RUN pnpm build

FROM nginxinc/nginx-unprivileged:1.29-alpine@sha256:0c79d56aee561a1d81c63f00eee5fb5fe29279560cdc55e91425133104c7fbe6
# OS security fixes newer than the base image (M8-T6); the image's nginx user (101) runs the server
USER root
RUN apk upgrade --no-cache
USER 101
# the image renders /etc/nginx/templates/*.template with the environment at start-up (only defined variables)
COPY infra/nginx.conf /etc/nginx/templates/default.conf.template
COPY --chmod=755 infra/web/20-csp.envsh /docker-entrypoint.d/20-csp.envsh
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
ENV API_UPSTREAM=http://api:8000
EXPOSE 8080
