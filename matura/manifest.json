{
  "slug": "agentcanvas",
  "name": "AgentCanvas",
  "client_id": "agentcanvas",
  "auth": {
    "redirect_uris": ["http://localhost:7777/*", "http://localhost:5173/*"],
    "post_logout_redirect_uris": ["http://localhost:7777/*", "http://localhost:5173/*"],
    "public_client": true
  },
  "permissions": [
    {"name": "canvas.read", "description": "See projects, workflows, runs, datasets and settings in the organisation"},
    {"name": "inbox.review", "description": "Answer inbox items, resume paused runs and annotate runs"},
    {"name": "workflow.build", "description": "Build, run, test and publish workflows, and manage deployments"},
    {"name": "org.admin", "description": "Change organisation settings, release gates, trace export and read the audit log"}
  ],
  "roles": [
    {"name": "viewer", "description": "Reads everything", "permissions": ["canvas.read"]},
    {"name": "reviewer", "description": "Reads and answers the inbox", "permissions": ["canvas.read", "inbox.review"]},
    {"name": "builder", "description": "Builds, runs and publishes", "permissions": ["canvas.read", "inbox.review", "workflow.build"]},
    {"name": "admin", "description": "Everything, including organisation settings", "permissions": ["canvas.read", "inbox.review", "workflow.build", "org.admin"]}
  ],
  "default_role": "viewer",
  "owner_role": "admin",
  "tenancy": {
    "workspace_scoped": false,
    "modes": ["shared"],
    "managers": ["app"],
    "default": {"mode": "shared", "manager": "app"}
  },
  "conformance": {
    "webhook_path": "/v1/matura/events",
    "resources": [{
      "name": "projects",
      "create": {"method": "POST", "path": "/v1/projects", "body": {"name": "conformance {{marker}}"}, "permission": "workflow.build"},
      "list": {"method": "GET", "path": "/v1/projects", "permission": "canvas.read"}
    }]
  }
}
