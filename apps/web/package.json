{
  "name": "agentcanvas-web",
  "version": "0.32.3",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json",
    "gen:ir": "json2ts -i ../../packages/ir-schema/ir.schema.json -o src/ir/generated.ts --bannerComment \"/* Generated from packages/ir-schema/ir.schema.json (pnpm gen:ir). Do not edit. */\" --additionalProperties false",
    "gen:api": "node scripts/gen-api-types.mjs",
    "gen:help": "node -e \"require('fs').copyFileSync('../../packages/ir-schema/diagnostics.json', 'src/help/diagnostics.generated.json')\"",
    "gen": "pnpm gen:ir && pnpm gen:api && pnpm gen:help",
    "lint": "oxlint src e2e --deny-warnings"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@rjsf/core": "^6.11.1",
    "@rjsf/utils": "^6.11.1",
    "@rjsf/validator-ajv8": "^6.11.1",
    "@tanstack/react-query": "^5.106.1",
    "@xyflow/react": "^12.12.1",
    "codemirror": "^6.0.2",
    "elkjs": "^0.12.1",
    "lucide-react": "1.70.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "ulid": "^3.0.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "~1.65.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "json-schema-to-typescript": "^16.0.0",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
