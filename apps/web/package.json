{
  "name": "agentcanvas-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json",
    "gen:ir": "json2ts -i ../../packages/ir-schema/ir.schema.json -o src/ir/generated.ts --bannerComment \"/* Generated from packages/ir-schema/ir.schema.json (pnpm gen:ir). Do not edit. */\" --additionalProperties false",
    "gen:api": "node scripts/gen-api-types.mjs",
    "gen": "pnpm gen:ir && pnpm gen:api"
  },
  "dependencies": {
    "@rjsf/core": "^6.11.0",
    "@rjsf/utils": "^6.11.0",
    "@rjsf/validator-ajv8": "^6.11.0",
    "@tanstack/react-query": "^5.104.0",
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "ulid": "^3.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "~1.56.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^27.4.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
