{
 "name": "Triage tickets",
 "nodes": [
  {
   "parameters": {
    "path": "tickets",
    "httpMethod": "POST"
   },
   "id": "webhook",
   "name": "Webhook",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "promptType": "define",
    "text": "=Classify this ticket as urgent or normal: {{ $json.ticket }}",
    "messages": {
     "messageValues": [
      {
       "message": "Answer with one word."
      }
     ]
    }
   },
   "id": "classify",
   "name": "Classify",
   "type": "@n8n/n8n-nodes-langchain.chainLlm",
   "typeVersion": 1.5,
   "position": [
    200,
    0
   ]
  },
  {
   "parameters": {
    "modelName": "models/gemini-2.5-flash",
    "options": {}
   },
   "id": "gemini",
   "name": "Gemini",
   "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
   "typeVersion": 1,
   "position": [
    200,
    200
   ]
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true
     },
     "conditions": [
      {
       "id": "1",
       "leftValue": "={{ $json.text }}",
       "rightValue": "urgent",
       "operator": {
        "type": "string",
        "operation": "contains"
       }
      }
     ],
     "combinator": "and"
    }
   },
   "id": "urgent?",
   "name": "Urgent?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    400,
    0
   ]
  },
  {
   "parameters": {
    "assignments": {
     "assignments": [
      {
       "id": "a",
       "name": "status",
       "value": "=Paged: {{ $('Classify').item.json.text }}",
       "type": "string"
      }
     ]
    }
   },
   "id": "page-on-call",
   "name": "Page on-call",
   "type": "n8n-nodes-base.set",
   "typeVersion": 3.4,
   "position": [
    600,
    -100
   ]
  },
  {
   "parameters": {
    "values": {
     "string": [
      {
       "name": "status",
       "value": "queued"
      }
     ]
    }
   },
   "id": "queue-it",
   "name": "Queue it",
   "type": "n8n-nodes-base.set",
   "typeVersion": 2,
   "position": [
    600,
    100
   ]
  },
  {
   "parameters": {
    "text": "={{ $json.status }}"
   },
   "id": "send-slack",
   "name": "Send Slack",
   "type": "n8n-nodes-base.slack",
   "typeVersion": 2,
   "position": [
    800,
    0
   ]
  },
  {
   "parameters": {},
   "id": "done",
   "name": "Done",
   "type": "n8n-nodes-base.noOp",
   "typeVersion": 1,
   "position": [
    1000,
    0
   ]
  }
 ],
 "connections": {
  "Webhook": {
   "main": [
    [
     {
      "node": "Classify",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Gemini": {
   "ai_languageModel": [
    [
     {
      "node": "Classify",
      "type": "ai_languageModel",
      "index": 0
     }
    ]
   ]
  },
  "Classify": {
   "main": [
    [
     {
      "node": "Urgent?",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Urgent?": {
   "main": [
    [
     {
      "node": "Page on-call",
      "type": "main",
      "index": 0
     }
    ],
    [
     {
      "node": "Queue it",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Page on-call": {
   "main": [
    [
     {
      "node": "Send Slack",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Queue it": {
   "main": [
    [
     {
      "node": "Send Slack",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Send Slack": {
   "main": [
    [
     {
      "node": "Done",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 }
}