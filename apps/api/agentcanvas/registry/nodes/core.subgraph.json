{
  "type": "core.subgraph",
  "kind": "runtime",
  "label": "Group of steps",
  "category": "Flow control",
  "icon": "layers",
  "color": "#0E7490",
  "description": "A small workflow inside one block, with its own data. Chosen fields are copied in before it runs and copied back out after. Double-click it to look inside.",
  "outputs": [
    {
      "name": "next",
      "type": "Flow",
      "description": "Where to go after the group has finished: connect the next step, or Finish."
    }
  ],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "workflow",
      "inputs",
      "outputs"
    ],
    "properties": {
      "workflow": {
        "type": "object",
        "title": "Steps",
        "format": "subgraph",
        "description": "The embedded workflow (double-click the node to open it)"
      },
      "inputs": {
        "type": "array",
        "title": "Channels passed in",
        "items": {
          "type": "string",
          "format": "channel"
        },
        "uniqueItems": true
      },
      "outputs": {
        "type": "array",
        "title": "Channels passed back",
        "items": {
          "type": "string",
          "format": "channel"
        },
        "uniqueItems": true
      }
    }
  },
  "list_read_fields": [
    "inputs"
  ],
  "list_write_fields": [
    "outputs"
  ],
  "interrupts": true
}
