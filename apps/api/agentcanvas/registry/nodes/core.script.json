{
  "type": "core.script",
  "kind": "runtime",
  "label": "Run Python code",
  "category": "Data",
  "icon": "code",
  "color": "#475569",
  "description": "Runs a Python function you wrote in the Workspace. It receives the current data and returns the fields to update: `def run(state) -> dict`.",
  "outputs": [
    {
      "name": "next",
      "type": "Flow",
      "description": "Where to go after the code has run: connect the next step, or Finish."
    }
  ],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "import_path"
    ],
    "properties": {
      "import_path": {
        "type": "string",
        "title": "Function",
        "format": "import_path",
        "pattern": "^[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)+:[A-Za-z_][A-Za-z0-9_]*$"
      },
      "writes": {
        "type": "array",
        "title": "Fields it updates",
        "items": {
          "type": "string",
          "format": "channel"
        }
      },
      "side_effects": {
        "type": "array",
        "title": "Side effects",
        "items": {
          "enum": [
            "external_write",
            "message_send",
            "code_exec",
            "spend",
            "pii_read"
          ]
        }
      }
    }
  },
  "list_write_fields": [
    "writes"
  ],
  "side_effects": [
    "code_exec"
  ]
}
