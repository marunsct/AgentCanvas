{
  "type": "mw.model_call_limit",
  "kind": "resource",
  "label": "Limit AI calls",
  "category": "Agent add-ons",
  "icon": "gauge",
  "color": "#9333EA",
  "description": "Stops the agent after a set number of AI model calls, so it cannot loop forever or run up a big bill. Technical: ModelCallLimitMiddleware.",
  "inputs": [],
  "outputs": [
    {
      "name": "middleware",
      "type": "Middleware",
      "description": "Plug this into an agent's \u201cmiddleware\u201d input."
    }
  ],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "run_limit": {
        "type": "integer",
        "title": "Per run",
        "minimum": 1,
        "default": 20
      },
      "thread_limit": {
        "type": "integer",
        "title": "Per thread",
        "minimum": 1
      },
      "exit_behavior": {
        "enum": [
          "end",
          "error"
        ],
        "title": "When reached",
        "default": "end"
      }
    }
  }
}
