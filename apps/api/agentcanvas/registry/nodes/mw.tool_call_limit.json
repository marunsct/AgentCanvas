{
  "type": "mw.tool_call_limit",
  "kind": "resource",
  "label": "Limit tool use",
  "category": "Agent add-ons",
  "icon": "gauge",
  "color": "#9333EA",
  "description": "Limits how many times the agent may use its tools (all of them, or one), per run or per conversation. Technical: ToolCallLimitMiddleware.",
  "inputs": [],
  "outputs": [
    {
      "name": "middleware",
      "type": "Middleware",
      "description": "Plug this into an agent's \u201cmiddleware\u201d input."
    }
  ],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "tool_name": {
        "type": "string",
        "title": "Only this tool",
        "description": "Empty = all tools"
      },
      "run_limit": {
        "type": "integer",
        "title": "Per run",
        "minimum": 1,
        "default": 10
      },
      "thread_limit": {
        "type": "integer",
        "title": "Per thread",
        "minimum": 1
      },
      "exit_behavior": {
        "enum": [
          "continue",
          "error",
          "end"
        ],
        "title": "When reached",
        "default": "continue"
      }
    }
  }
}
