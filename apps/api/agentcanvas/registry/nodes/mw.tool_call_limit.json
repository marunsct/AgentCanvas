{
  "type": "mw.tool_call_limit",
  "kind": "resource",
  "label": "Tool call limit",
  "category": "Middleware",
  "icon": "gauge",
  "color": "#9333EA",
  "description": "Limits tool calls per run or thread, for all tools or one tool (ToolCallLimitMiddleware).",
  "inputs": [],
  "outputs": [
    {
      "name": "middleware",
      "type": "Middleware"
    }
  ],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "tool_name": {
        "type": "string",
        "title": "Only this tool",
        "description": "Empty = all tools"
      },
      "run_limit": {
        "type": "integer",
        "title": "Per run",
        "minimum": 1,
        "default": 10
      },
      "thread_limit": {
        "type": "integer",
        "title": "Per thread",
        "minimum": 1
      },
      "exit_behavior": {
        "enum": [
          "continue",
          "error",
          "end"
        ],
        "title": "When reached",
        "default": "continue"
      }
    }
  }
}
