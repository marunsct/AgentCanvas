{
  "type": "mcp.server",
  "kind": "resource",
  "label": "App connector (MCP)",
  "category": "Tools",
  "icon": "plug",
  "color": "#4B5563",
  "stability": "beta",
  "description": "Connects an agent to all the tools of an app through the Model Context Protocol (MCP). Use \u201cBrowse tools\u201d to pick tools and see which ones change things.",
  "outputs": [
    {
      "name": "tools",
      "type": "Tool",
      "description": "Every tool you picked from the app. Plug this into an agent's \u201ctools\u201d input."
    }
  ],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "transport": {
        "enum": [
          "http",
          "stdio"
        ],
        "title": "Transport",
        "default": "http",
        "description": "stdio starts a local process: local edition + admin setting only (E042)"
      },
      "url": {
        "type": "string",
        "title": "Server URL",
        "format": "uri",
        "pattern": "^https?://"
      },
      "headers": {
        "type": "object",
        "title": "Headers",
        "additionalProperties": {
          "anyOf": [
            {
              "type": "string",
              "title": "Value"
            },
            {
              "type": "object",
              "title": "Secret",
              "required": [
                "$secret"
              ],
              "additionalProperties": false,
              "properties": {
                "$secret": {
                  "type": "string",
                  "title": "Secret name"
                }
              }
            }
          ]
        }
      },
      "command": {
        "type": "string",
        "title": "Command (stdio)"
      },
      "args": {
        "type": "array",
        "title": "Arguments (stdio)",
        "items": {
          "type": "string"
        }
      },
      "env": {
        "type": "object",
        "title": "Environment variables (stdio)",
        "description": "For the server process, e.g. its API key; a value can be a secret",
        "additionalProperties": {
          "anyOf": [
            {
              "type": "string",
              "title": "Value"
            },
            {
              "type": "object",
              "title": "Secret",
              "required": [
                "$secret"
              ],
              "additionalProperties": false,
              "properties": {
                "$secret": {
                  "type": "string",
                  "title": "Secret name"
                }
              }
            }
          ]
        }
      },
      "tool_filter": {
        "type": "array",
        "title": "Only these tools",
        "items": {
          "type": "string"
        },
        "uniqueItems": true,
        "description": "Empty = every tool the server offers"
      },
      "discovered": {
        "type": "array",
        "title": "Discovered tools",
        "readOnly": true,
        "description": "Filled by Browse tools; used to check approvals (W002, E033)",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "destructive": {
              "type": "boolean"
            },
            "read_only": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
