  {"id": "ollama", "label": "Ollama (local)", "package": "langchain-ollama", "module": "langchain_ollama", "local": true, "base_url": "http://localhost:11434", "example": "ollama:llama3.3", "notes": "Pull the model first: ollama pull <model>."},
  {"id": "lmstudio", "label": "LM Studio (local)", "package": "langchain-openai", "module": "langchain_openai", "local": true, "base_url": "http://localhost:1234/v1", "example": "lmstudio:<model loaded in LM Studio>", "notes": "Start LM Studio's local server first."},
  {"id": "vllm", "label": "vLLM (local)", "package": "langchain-openai", "module": "langchain_openai", "local": true, "base_url": "http://localhost:8000/v1", "example": "vllm:<served model name>", "notes": "The default port 8000 is also the AgentCanvas API's in development: run vLLM on another port and set the base URL."},
  {"id": "llamacpp", "label": "llama.cpp server (local)", "package": "langchain-openai", "module": "langchain_openai", "local": true, "base_url": "http://localhost:8080/v1", "example": "llamacpp:<model>"},
  {"id": "openai_compatible", "label": "Any OpenAI-compatible API", "package": "langchain-openai", "module": "langchain_openai", "base_url_required": true, "example": "openai_compatible:<model>", "notes": "Set the base URL (e.g. https://api.together.xyz/v1, https://openrouter.ai/api/v1) and an API key secret if it needs one."}
