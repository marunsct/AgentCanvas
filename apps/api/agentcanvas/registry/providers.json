  {"id": "azure_openai", "label": "Azure OpenAI", "package": "langchain-openai", "module": "langchain_openai", "key_env": "AZURE_OPENAI_API_KEY", "example": "azure_openai:<deployment>", "notes": "Also set azure_endpoint and api_version (or AZURE_OPENAI_ENDPOINT and OPENAI_API_VERSION on the server)."},
  {"id": "google_genai", "label": "Google Gemini", "package": "langchain-google-genai", "module": "langchain_google_genai", "key_env": "GOOGLE_API_KEY", "example": "google_genai:gemini-2.5-flash"},
  {"id": "mistralai", "label": "Mistral AI", "package": "langchain-mistralai", "module": "langchain_mistralai", "key_env": "MISTRAL_API_KEY", "example": "mistralai:mistral-large-latest"},
  {"id": "groq", "label": "Groq", "package": "langchain-groq", "module": "langchain_groq", "key_env": "GROQ_API_KEY", "example": "groq:llama-3.3-70b-versatile"},
  {"id": "deepseek", "label": "DeepSeek", "package": "langchain-deepseek", "module": "langchain_deepseek", "key_env": "DEEPSEEK_API_KEY", "example": "deepseek:deepseek-chat"},
