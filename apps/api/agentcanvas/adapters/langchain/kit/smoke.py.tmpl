"""Does the deployed service answer? `make smoke URL=https://...` (standard library only).

Checks /healthz, runs the workflow once with the example input in kit.json, answers "yes" to any approval it asks
for, and prints the answer. The API key is the first of API_KEYS in the environment or .env (or SMOKE_API_KEY).
"""

from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from checks import KIT, approve, load_env  # noqa: E402


def call(url: str, key: str, path: str, body: dict | None = None, timeout: float = 300) -> tuple[int, dict]:
    req = urllib.request.Request(
        url.rstrip("/") + path,
        data=json.dumps(body).encode() if body is not None else None,
        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
        method="POST" if body is not None else "GET",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        return e.code, json.loads(e.read() or b"{}")


def main(argv: list[str]) -> int:
    load_env()
    url = argv[0] if argv else os.environ.get("URL", "http://localhost:8000")
    key = os.environ.get("SMOKE_API_KEY") or os.environ.get("API_KEYS", "").split(",")[0].strip()
    if not key:
        print("No API key: set API_KEYS in .env (make setup) or SMOKE_API_KEY.")
        return 1
    try:
        status, health = call(url, key, "/healthz", timeout=15)
    except OSError as exc:
        print(f"✗ {url} does not answer: {exc}  → docs/4-VERIFY-AND-OPERATE.md#if-something-is-wrong")
        return 1
    if status != 200 or not health.get("ok"):
        print(f"✗ /healthz answered {status}: {health}")
        return 1
    print(f"✓ {url}/healthz: {health['workflow']} {health['version']}")
    base = f"/v1/deployments/{KIT['slug']}"
    status, out = call(url, key, f"{base}/runs/wait", {"input": KIT["example_input"], "context": KIT.get("example_context", {})})
    for _ in range(5):  # approvals and questions in the example: answer yes
        if status != 200 or out.get("status") != "interrupted" or not out.get("interrupts"):
            break
        first = out["interrupts"][0]
        value = approve(first)
        print(f"  … it asks ({first.get('kind')}); answering {value!r}")
        status, out = call(url, key, f"{base}/threads/{out['thread_id']}/resume",
                           {"value": value, "interrupt_id": first["id"]})  # fmt: skip
    if status == 401:
        print("✗ the key was refused: the service's API_KEYS differ from yours")
        return 1
    if status != 200 or out.get("status") not in ("success", "interrupted"):
        print(f"✗ the run failed ({status}): {out.get('error') or out.get('detail') or out}")
        print("  → docs/4-VERIFY-AND-OPERATE.md#if-something-is-wrong")
        return 1
    print(f"✓ a run finished ({out['status']}) in thread {out['thread_id']}:")
    print(json.dumps(out.get("output"), indent=2, ensure_ascii=False)[:2000])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
