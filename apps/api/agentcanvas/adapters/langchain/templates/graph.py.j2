{%- endif %}
{% endfor %}
    # ── flow edges ──
{%- for src, dst in plan.plain_edges %}
    builder.add_edge({{ src if src in ("START", "END") else (src | py) }}, {{ dst if dst in ("START", "END") else (dst | py) }})
{%- endfor %}
{%- for sources, join in plan.join_edges %}
