async def abuild_graph(resources: ac.Resources | None = None, checkpointer=None, store=None, cache=None):
    """Async entry point{% if plan.mcp %}: discovers MCP tools first (network I/O){% endif %}."""
    resources = resources or ac.Resources()
{%- for pr in plan.mcp %}
    await resources.load_mcp({{ pr.resource.name | py }}, {{ pr.resource.config | pp }})
{%- endfor %}
    return build_graph(resources, checkpointer=checkpointer, store=store, cache=cache)
