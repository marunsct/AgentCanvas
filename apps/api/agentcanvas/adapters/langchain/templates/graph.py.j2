    builder.add_node({{ n.name | py }}, interop.a2a_agent_node(node_id={{ n.id | py }}, name={{ n.name | py }}, url={{ n.config.url | py }}, prompt={{ n.config.get("prompt", "") | py }}, output={{ n.config.output | py }}, headers={{ n.config.get("headers") | pp }}, approve={{ n.config.get("approve", False) | py }}, allow_private_network={{ n.config.get("allow_private_network", False) | py }}, timeout={{ n.config.get("timeout", 120) | py }}, resolve=resources.resolve, transport=resources.http_transport), {{ meta }})
{%- elif n.type == "agent.mcp" %}
